    given-names: Zhida
  - family-names: Wu
    given-names: Tao
  - family-names: Liu
    given-names: Siyu
  - family-names: Cao
    given-names: Jie
license: MIT
repository-code: "https://github.com/LF-Jade/look-closer"
year: 2026
keywords:
  - AI-generated image detection
  - image forensics
  - patch-wise supervision
  - deepfake detection

